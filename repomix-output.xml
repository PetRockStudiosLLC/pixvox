      const input = document.createElement('input');
      input.type = 'file';
      input.accept = '.json';
      const filePromise = new Promise<File | null>((resolve) => {
        input.onchange = () => {
          if (input.files && input.files[0]) resolve(input.files[0]);
          else resolve(null);
