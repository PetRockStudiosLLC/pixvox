# Android build configuration
# Copy this file to .env and fill in your values

# Path to Android SDK/NDK (can also use ANDROID_HOME system env variable)
ANDROID_HOME=G:\1_CURRENT\PixelArtMaker\android-home
NDK_VERSION=30.0.14904198

# Gradle settings
GRADLE_USER_HOME=G:\gradle-home

# Keystore configuration
KEYSTORE_PATH=G:\1_CURRENT\PixelArtMaker\android-key.keystore
KEYSTORE_ALIAS=pixvox
KEYSTORE_PASSWORD=
KEY_PASSWORD=

# App configuration
APP_PACKAGE_NAME=com.pixvox
APP_NAME=PixVox

# Build output directory
BUILD_OUTPUT_DIR=G:\1_CURRENT\PixelArtMaker\build

# Device connection
ADB_DEVICE=
